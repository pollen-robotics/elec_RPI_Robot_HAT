         <pdf:Keywords/>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">CAT24C32 - EEPROM Serial 32-Kb I2C</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The CAT24C32 is a EEPROM Serial 32âˆ’Kb I2C devices, internally&#xA;organized as 4096 words of 8 bits each.&#xA;It features a 32âˆ’byte page write buffer and supports the Standard&#xA;(100 kHz), Fast (400 kHz) and Fastâˆ’Plus (1 MHz) I2C protocol.&#xA;External address pins make it possible to address up to eight&#xA;CAT24C32 devices on the same bus.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:60fe9d5e-e5d6-475e-a393-033091785d39</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:9adf1a18-bfe2-4fc1-bf96-336563380c65</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
