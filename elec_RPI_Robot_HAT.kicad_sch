	(text "\"RPI_Robot_HAT\" is a raspberry PI HAT designed for small/medium \nsize robots. It has an IMU, Dynamixel connectors and audio. Its\ndimensions fits a raspberry PI zero"
		(exclude_from_sim no)
		(at 19.304 27.686 0)
		(effects
			(font
				(size 2.0066 2.0066)
			)
			(justify left bottom)
		)
		(uuid "ac9667d7-cd1e-4c91-8948-647041f3fcde")
	)
	(text "Designer"
		(exclude_from_sim no)
		(at 62.23 38.1 0)
		(effects
			(font
				(size 2.0066 2.0066)
			)
			(justify left bottom)
		)
		(uuid "b088e14a-2a87-440c-a033-f65020b82725")
	)
	(text "Cabled GPIOs on the 40-way Header:\n - GPIO00/01: HAT identification over I2C (reserved)\n - GPIO02: IMU + Audio + Stemma/QT - SDA\n - GPIO03: IMU + Audio + Stemma/QT - SCL\n - GPIO04: Stemma/QT - SDA\n - GPIO05: Stemma/QT - SCL\n - GPIO06: Switch off detection\n - GPIO07\n - GPIO08: Stemma/QT - SDA\n - GPIO09: Stemma/QT - SCL\n - GPIO10: Stemma/QT - SDA\n - GPIO11: Stemma/QT - SCL\n - GPIO12\n - GPIO13:\n - GPIO14: Dynamixel - UART_Tx\n - GPIO15: Dynamixel - UART_Rx\n - GPIO16\n - GPIO17\n - GPIO18: Audio, PCM Clk\n - GPIO19: Audio, PCM FS\n - GPIO20: Audio, Din\n - GPIO21: Audio, Dout\n - GPIO22: IMU_IT\n - GPIO23\n - GPIO24\n - GPIO25\n - GPIO26\n - GPIO27\n"
		(exclude_from_sim no)
		(at 182.372 154.686 0)
		(effects
			(font
				(size 2.0066 2.0066)
			)
			(justify left bottom)
		)
