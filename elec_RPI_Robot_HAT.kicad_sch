	(text "Cabled buses on Raspberry PIs\n - PI zero 2W:\n     - I2C0 (           pin 27/28 ID_SD/C): reserved, but can be on J6 with 0R\n     - I2C1 (IO  2/ 3 - pin  3/ 5 SDA/SCL): IMU + Audio + Qwiic J5\n - PI 4:\n     - same I2C0/1\n     - I2C3 (IO  4/ 5 - pin  7/29 SDA/SCL): Qwiic J6\n     - I2C4 (IO  8/ 9 - pin 24/21 SDA/SCL): Qwiic J7\n     - I2C5 (IO 10/11 - pin 19/23 SDA/SCL): Qwiic J8\n - PI 5:\n     - same I2C0/1\n     - I2C2 (IO  2/ 3 - pin  3/ 5 SDA/SCL): Qwiic J5"
		(exclude_from_sim no)
		(at 181.102 57.912 0)
		(effects
			(font
				(face "Liberation Mono")
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "573da85b-985d-4719-aad6-0916966dd1a9")
	)
