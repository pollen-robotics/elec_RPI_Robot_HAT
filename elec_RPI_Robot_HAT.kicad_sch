	(text "Fiducials"
		(exclude_from_sim no)
		(at 135.128 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2e98ae0d-ae46-4a9e-8b64-d34a59e24417")
	)
	(text "Cabled buses on Raspberry PIs\n - PI zero 2W:\n     - I2C0 (           pin 27/28 ID_SD/C): reserved, but can be on J6 with 0R\n     - I2C1 (IO  2/ 3 - pin  3/ 5 SDA/SCL): IMU + Audio + Qwiic J5\n - PI 4:\n     - same I2C0/1\n     - I2C3 (IO  4/ 5 - pin  7/29 SDA/SCL): Qwiic J6\n     then choose between:\n     - I2C4 (IO  8/ 9 - pin 24/21 SDA/SCL): Qwiic J7\n     - I2C5 (IO 10/11 - pin 19/23 SDA/SCL): Qwiic J8\n - PI 5:\n     - same I2C0/1\n     - I2C2 (IO  2/ 3 - pin  3/ 5 SDA/SCL): Qwiic J5"
		(exclude_from_sim no)
		(at 181.102 57.912 0)
		(effects
			(font
				(face "Liberation Mono")
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "573da85b-985d-4719-aad6-0916966dd1a9")
	)
	(text "ASE01187"
		(exclude_from_sim no)
		(at 101.6 139.065 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "64f83ac9-3529-4dbb-bb27-271f6238e29c")
	)
	(text "\"RPI_Robot_HAT\" is a raspberry PI HAT designed for small/medium \nsize robots. It has an IMU, Dynamixel connectors and audio. Its\ndimensions fits a raspberry PI zero"
		(exclude_from_sim no)
		(at 40.132 103.886 0)
		(effects
			(font
				(size 2.0066 2.0066)
			)
			(justify left bottom)
		)
		(uuid "ac9667d7-cd1e-4c91-8948-647041f3fcde")
	)
	(text "Cabled GPIOs on the 40-way Header:\n - GPIO00/01: HAT identification over I2C (reserved)\n - GPIO02: IMU + Audio + Stemma/QT - SDA\n - GPIO03: IMU + Audio + Stemma/QT - SCL\n - GPIO04: Stemma/QT - SDA\n - GPIO05: Stemma/QT - SCL\n - GPIO06: Switch off detection\n - GPIO07\n - GPIO08: Stemma/QT - SDA\n - GPIO09: Stemma/QT - SCL\n - GPIO10: Stemma/QT - SDA\n - GPIO11: Stemma/QT - SCL\n - GPIO12\n - GPIO13:\n - GPIO14: Dynamixel - UART_Tx\n - GPIO15: Dynamixel - UART_Rx\n - GPIO16\n - GPIO17\n - GPIO18: Audio, PCM Clk\n - GPIO19: Audio, PCM FS\n - GPIO20: Audio, Din\n - GPIO21: Audio, Dout\n - GPIO22: IMU_IT\n - GPIO23\n - GPIO24\n - GPIO25\n - GPIO26\n - GPIO27\n"
		(exclude_from_sim no)
		(at 182.372 154.686 0)
		(effects
			(font
				(size 2.0066 2.0066)
			)
			(justify left bottom)
		)
		(uuid "d193b307-c435-42ea-9e27-3882764c5d73")
	)
